{
  "info": {
    "name": "LogShare API",
    "description": "LogShare 1.8.5 file-based API collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://api.logshare.cn" },
    { "key": "logId", "value": "sAbCdEf" },
    { "key": "token", "value": "" },
    { "key": "filename", "value": "latest.log" }
  ],
  "item": [
    {
      "name": "Logs",
      "item": [
        {
          "name": "Submit a log",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/v1/log",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"files\": [\n    {\n      \"name\": \"latest.log\",\n      \"content\": \"[12:34:56] [Server thread/INFO]: Starting minecraft server version 1.21.1\\n\"\n    },\n    {\n      \"name\": \"crash-reports/crash-01.txt\",\n      \"content\": \"---- Minecraft Crash Report ----\\n\"\n    }\n  ],\n  \"metadata\": [\n    { \"key\": \"version\", \"value\": \"1.21.1\", \"label\": \"Minecraft 版本\" }\n  ],\n  \"source\": \"launcher/1.0.0\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Upload files only. No content field. Limits: 200 files / 20 MiB total / 32 MiB request body. Multi-file logs return a file list when accessed without a filename."
          },
          "response": []
        },
        {
          "name": "Delete one or more logs",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/v1/log/{{logId}}",
            "description": "Comma-separated IDs are allowed. Requires the deletion token."
          },
          "response": []
        },
        {
          "name": "Get log metadata and files",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/v1/log/{{logId}}",
            "description": "Returns fileCount, requiresFileSelection and files with raw/insights URLs."
          },
          "response": []
        },
        {
          "name": "Get raw content or file list",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "text/plain, application/json" }
            ],
            "url": "{{baseUrl}}/v1/raw/{{logId}}",
            "description": "Single file: text/plain. Multiple files: 200 + file list."
          },
          "response": []
        },
        {
          "name": "Get one file",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "text/plain" }
            ],
            "url": "{{baseUrl}}/v1/raw/{{logId}}/{{filename}}",
            "description": "Returns the selected file as text/plain."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Analysis",
      "item": [
        {
          "name": "Get insights or file list",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/v1/insights/{{logId}}",
            "description": "Single file: Codex analysis JSON. Multiple files: 200 + file list."
          },
          "response": []
        },
        {
          "name": "Analyse one file",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/v1/insights/{{logId}}/{{filename}}",
            "description": "Run Codex detect -> parse -> analyse on the selected file."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Meta",
      "item": [
        {
          "name": "API index",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/"
          },
          "response": []
        },
        {
          "name": "Get upload limits",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/v1/limits",
            "description": "Returns storageTime, maxFiles, maxTotalBytes and maxRequestBodyBytes."
          },
          "response": []
        }
      ]
    }
  ]
}
