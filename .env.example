MARIADB_PASSWORD=change-me
MARIADB_ROOT_PASSWORD=change-me
REDIS_PASSWORD=change-me
# 管理后台：启用前必须填一个 >=32 字符的随机串（openssl rand -hex 32）。
# 留空时 ADMIN_ENABLED 必须为 false，否则启动即失败（不会退回占位口令）。
ADMIN_ENABLED=false
ADMIN_TOKEN=
# 边缘 WAF 解封端点（POST /security/unban）的运维令牌，需 ≥16 字符；
# 留空时该端点一律返回 404（fail-closed），后台解封只影响应用层封禁
OPENLITEWAF_ADMIN_TOKEN=replace-with-long-random-token
